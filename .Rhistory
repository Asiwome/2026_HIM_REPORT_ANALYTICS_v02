# Matches C00-C97, with optional decimal and up to 4 more characters (ICD-10-CM e.g. C50.911, C7A.012)
mal_pattern <- "\\bC(?:[0-8][0-9]|9[0-7]|7[ABab])(?:\\.?[0-9A-Za-z]{1,4})?\\b"
names(opd_dx_cancer)
view(opd_dx_cancer)
opd_dx_cancer <- opd_dx_cancer %>%
mutate(is_malignant = str_detect(code, regex(mal_pattern, ignore_case = TRUE)))
tabyl(opd_dx_cancer, is_malignant)
tabyl(opd_dx_cancer, is_malignant, diagnosis_type)
tabyl(opd_dx_cancer, diagnosis_type, is_malignan)
tabyl(opd_dx_cancer, diagnosis_type, is_malignant)
filter(isTRUE(is_malignant))
