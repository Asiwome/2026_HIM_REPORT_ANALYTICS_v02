# Matches C00-C97, with optional decimal and up to 4 more characters (ICD-10-CM e.g. C50.911, C7A.012)
mal_pattern <- "\\bC(?:[0-8][0-9]|9[0-7]|7[ABab])(?:\\.?[0-9A-Za-z]{1,4})?\\b"
opd_dx_df <- read_csv("DataFiles/Database_Registers/Data_Warehouse/OPD_Diagnoses/2026-JAN-SEP_OPD-CONDITIONS-TTH.csv") |>
mutate(
code = trimws(icd10_code, which = "both"),
icd10_code2 = recode(
icd10_code,
"I64"=	"I639", "I500" = "I509", "V5849" =	"Z4889", "A099" =	"A09", "Z2251"	= "Z228",
"Z2252" =	"Z228", "B004.A0" =	"A010", "NI89" =	"N189", "O809" =	"O80", "R104"	= "R109",
"K749"	= "K7460", "O06"	= "O03", "I845" =	"K649", "K056" =	"k053", "I986"	= "S026",
"I849"	 = "I849", "T814XXA" =	"T8140", "B004-A1" =	"A178", "I859" =	"I85","B004-A0" =	"A178",
"E141" =	"E131","N3590"	= "N359","X791"	= "X79","A090"	= "A09","H4011X3"	= "H4010X3",
"O822"	= "Z9071", "NI82" =	"N182", "M841"	= "M8430XP", "O756" =	"O75", "KO55"	= "K055",
"I849" = "K649","k053"="K053", "S027" = "S026", "C536" = "N879", "H4011X1"="H401191",
"Z225" = "Z228","k055" = "K0530","G419" = "G459",  "H4011X2"="H401191",
"K103"="M273", "K350" = "K3532", "N459" = "N453", "S327"="S3281","T793" = "L89",
"Z2250"="Z228","D895" = "S02401A", "H131" = "H109",  "HI51" = "H1510","K351" = "K358",
"K37" = "K377", "R568"= "R569", "T144" = "T149", "T814XXS" = "T814XXS", "G41"="G459","K009"= "K009",
"K914" = "K9410", "M840" = "M8430XP","S0210XD" = "S0210" ,"S0267XA"= "S0267"  ,
"S028XXD" = "S028", "S028XXS" = "S028","T1490" = "T1490","T814XXD" = "T814", "Z22" = "Z2259",
"I849" = "K649"
)
)
opd_dx_cancer <- opd_dx_df %>%
mutate(is_malignant = str_detect(code, regex(mal_pattern, ignore_case = TRUE))) |>
filter(is_malignant==TRUE)
view(opd_dx_cancer)
opd_dx_cancer <- opd_dx_df %>%
mutate(is_malignant = str_detect(code, regex(mal_pattern, ignore_case = TRUE))) |>
filter(is_malignant==TRUE) |>
distinct(ID, .keep_all = T)
view(opd_dx_cancer)
opd_dx_cancer_icd10 <- inner_join(opd_dx_cancer, icdver, by ="code") |>
mutate(disease_name=major)
tabyl(opd_dx_cancer, disease_name)
tabyl(opd_dx_cancer, major)
tabyl(opd_dx_cancer, opd_dx_cancer_icd10)
tabyl(opd_dx_cancer_icd10, disease_name)
names(opd_dx_cancer_icd10)
