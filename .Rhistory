#| label: tbl-jan
ipd_dx_name_jan <- ipd_dx1_poly_icd10 |>
filter(dx_month == "Jan") |>
filter(!is.na(disease_name)) |>
group_by(disease_name) |>
summarise(N = n(), .groups = "drop") |>
arrange(desc(N)) |>
slice_head(n = 10) |>
select(disease_name, N)
ipd_table1 <- flextable(ipd_dx_name_jan) |>
set_header_labels(
disease_name = "Major Disease Name/ICD-10",
N = "Frequency"
) |>
autofit()
ipd_table1
